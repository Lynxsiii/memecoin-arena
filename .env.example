# Memecoin arena settings (see README.md). Copy to .env and fill in the secrets; .env is git-ignored.
# The webhook URL lets anyone post to your channel, and the Helius key spends your Helius credits.
ARENA_DISCORD_WEBHOOK=
ARENA_HELIUS_KEY=
# Run 8 (2026-10-07): pump.fun only, see docs/superpowers/specs/2026-10-07-run8-pumpfun-long-run-design.md
ARENA_ROUTE=pumpfun
ARENA_UNIVERSE=pumpfun
ARENA_TRADERS_RANK=realized
ARENA_SHADOW_LEADERS=10
ARENA_LLM_MIN_CHECK=1
ARENA_LLM_MAX_CHECK=60

# GeckoTerminal budget while DexScreener is down (free tier ~30/min shared with the trader tracker)
ARENA_GECKO_FALLBACK_PER_MIN=10
ARENA_TRADERS_GECKO_PER_MIN=4

# Run 8b (2026-10-07): points = best single life, a lost life comes back every hour, no buy cap or cooldown
# (the $50 minimum stays), market memory warmed up from this run only. These are the defaults:
# ARENA_LIFE_REGEN_MIN=60
# ARENA_LLM_MAX_BUYS_PER_DAY=0
# ARENA_LLM_BUY_COOLDOWN_MIN=0
# ARENA_MEMORY_FROM_RUN=1

# StalkChain Data (stalkchain.py): paid on-chain lookups, off while the key is empty. Create a key at
# https://data.stalkchain.com (dashboard), then paste it here. 250 credits = one normal lookup.
#   Pre-buy check: a Claude's first buy of a coin runs deployer (500) + early_buyers (500) = 1,000 credits per new coin.
#   Smart-money entries: 125 credits per poll; every 30 minutes = 48 polls = 6,000 credits a day.
#   Starter (375,000 credits/month) ~ 12,500/day: the 12,000 budget covers ~12 new coins/day with entries off, ~6 with
#   entries every 30 min (or set ENTRIES_MIN=120: 1,500/day, ~10 coins). Growth (1,250,000/month ~ 41,000/day): set
#   ARENA_STALKCHAIN_DAILY_CREDITS=40000 for ~40 new coins/day.
ARENA_STALKCHAIN_KEY=
# reuse a coin's lookups for this many hours (no second charge)
ARENA_STALKCHAIN_CACHE_H=6
# rolling 24 hour credit budget; past it lookups are skipped (a skipped lookup never blocks a buy)
ARENA_STALKCHAIN_DAILY_CREDITS=12000
# pre-buy lookups: deployer, early_buyers, quality (quality adds 250 credits: wash-trading share)
ARENA_STALKCHAIN_PREBUY=deployer,early_buyers
# refuse the buy when the deployer's earlier launches include this many dead/rugged ones (or half of 2+)
ARENA_STALKCHAIN_RUG_VETO=2
# minutes between smart-money entry polls (0 = off)
ARENA_STALKCHAIN_ENTRIES_MIN=30

# SOL price in dollars used before DexScreener has priced SOL (the graduation cap fallback: 425 SOL x this) and to
# place a PumpSwap pool in its market-cap fee tier for formula fills. Keep it near the current SOL price.
ARENA_SOL_USD=115
